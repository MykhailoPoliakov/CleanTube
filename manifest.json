{
  "manifest_version": 3,
  "name": "YT no-slop",
  "version": "1.0",
  "description": "Removes ads, Shorts, and homepage clutter from YouTube.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128":"icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["video-ads.js", "feed-ads.js", "yt-shorts.js", "main.js"], 
      "ccs": ["hide-ads.css"],
      "run_at": "document_idle"
    }
  ]
}